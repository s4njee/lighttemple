{
  "name": "@mk7s/lighttemple",
  "version": "0.1.0",
  "description": "An experimental WebGPU gallery of practical lighting & shadow effects for aesthetic websites.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s4njee/lighttemple.git"
  },
  "homepage": "https://github.com/s4njee/lighttemple",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "files": [
    "lib",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./types/lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./effects/*": {
      "types": "./types/experiments/*/index.d.ts",
      "import": "./lib/effects/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "clean:types": "node -e \"require('node:fs').rmSync('types', { recursive: true, force: true })\"",
    "build:lib": "vite build --config vite.lib.config.ts && npm run clean:types && tsc -p tsconfig.lib.json && node scripts/rewrite-dts.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke": "vite build && node scripts/smoke.mjs",
    "new": "node scripts/new-experiment.mjs",
    "catalogue": "node scripts/catalogue.mjs"
  },
  "dependencies": {
    "wgpu-matrix": "3.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@webgpu/types": "0.1.74",
    "eslint": "^10.12.0",
    "playwright-core": "1.56.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3"
  }
}
