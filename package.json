{
  "name": "lighttemple",
  "private": true,
  "version": "0.1.0",
  "description": "An experimental WebGPU gallery of practical lighting & shadow effects for aesthetic websites.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "vite build && node scripts/smoke.mjs",
    "new": "node scripts/new-experiment.mjs"
  },
  "dependencies": {
    "wgpu-matrix": "3.4.2"
  },
  "devDependencies": {
    "@webgpu/types": "0.1.74",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/s4njee/lighttemple.git"
  },
  "homepage": "https://github.com/s4njee/lighttemple"
}
